{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alarma-comunitaria",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  // Mantiene las variables definidas en el panel de Cloudflare (ej. CODIGO_COMUNIDAD)
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/*", "/app", "/app.apk"]
  },
  "kv_namespaces": [
    { "binding": "VECI_KV" }
  ]
}
