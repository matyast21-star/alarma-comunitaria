{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alarma-comunitaria",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "VECI_KV" }
  ]
}
